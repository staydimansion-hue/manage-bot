# ---- Slack ----------------------------------------------------------------
# Bot token (xoxb-...). Scopes: chat:write, channels:history, groups:history.
SLACK_BOT_TOKEN=

# ---- Supabase (Postgres) ---------------------------------------------------
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Service-role key (server-side only, never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic (auto-extraction) ------------------------------------------
# API key for the cheap LLM extraction step. If unset, extraction is skipped.
ANTHROPIC_API_KEY=
# Model id. Defaults to the cheapest Haiku if unset.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- App secrets -----------------------------------------------------------
# Shared secret required (?token=) to call the cron endpoints.
CRON_SECRET=
# Shared token for the lightweight admin page auth (?token=).
ADMIN_TOKEN=
